# ArduCNC UNO Q + CNC Shield v3
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt unoq_spi spi_speed=20000000

addf motion-command-handler servo-thread
addf motion-controller      servo-thread
addf unoq.update            servo-thread

# Drivers on whenever the machine is on.
net machine-on motion.motion-enabled => unoq.enable

# Joints 0..2 -> unoq 0..2 (X, Y, Z)
setp unoq.0.position-scale [JOINT_0]SCALE
setp unoq.0.maxvel   [JOINT_0]STEPGEN_MAXVEL
setp unoq.0.maxaccel [JOINT_0]STEPGEN_MAXACCEL
net j0-pos-cmd joint.0.motor-pos-cmd => unoq.0.position-cmd
net j0-pos-fb  unoq.0.position-fb    => joint.0.motor-pos-fb
net j0-enable  joint.0.amp-enable-out => unoq.0.enable

setp unoq.1.position-scale [JOINT_1]SCALE
setp unoq.1.maxvel   [JOINT_1]STEPGEN_MAXVEL
setp unoq.1.maxaccel [JOINT_1]STEPGEN_MAXACCEL
net j1-pos-cmd joint.1.motor-pos-cmd => unoq.1.position-cmd
net j1-pos-fb  unoq.1.position-fb    => joint.1.motor-pos-fb
net j1-enable  joint.1.amp-enable-out => unoq.1.enable

setp unoq.2.position-scale [JOINT_2]SCALE
setp unoq.2.maxvel   [JOINT_2]STEPGEN_MAXVEL
setp unoq.2.maxaccel [JOINT_2]STEPGEN_MAXACCEL
net j2-pos-cmd joint.2.motor-pos-cmd => unoq.2.position-cmd
net j2-pos-fb  unoq.2.position-fb    => joint.2.motor-pos-fb
net j2-enable  joint.2.amp-enable-out => unoq.2.enable

# Probe input from the shield (A5)
net probe unoq.input.probe => motion.probe-input

# E-stop: software only for now. Losing the MCU link drops the machine out
# of the enabled state (and the MCU itself disables the drivers within 20 ms).
net link-ok unoq.connected => iocontrol.0.emc-enable-in

# No tool changer
net tool-change iocontrol.0.tool-change => iocontrol.0.tool-changed
net tool-prep   iocontrol.0.tool-prepare => iocontrol.0.tool-prepared

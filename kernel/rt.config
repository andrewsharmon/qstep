# PREEMPT_RT fragment for the UNO Q kernel: arduino/linux-qcom 6.16 at effa862,
# the kernel of Arduino's image 20250807-136. kernel/build-rt-kernel.sh merges
# it on top of that image's config (kernel/config-6.16.0-geffa8626771a.stock).
# The stock image ships CONFIG_PREEMPT=y (low-latency desktop), which is not
# enough for a 1 kHz LinuxCNC servo thread.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
# CONFIG_PREEMPT is not set
# CONFIG_PREEMPT_DYNAMIC is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y
# Pin the CPUs at max clock so frequency transitions don't add latency.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
# Tracing for latency analysis (dynamic ftrace is patched to NOPs when idle).
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_OSNOISE_TRACER=y
CONFIG_TIMERLAT_TRACER=y

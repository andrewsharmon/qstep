[Unit]
Description=QStep boot setup (MCU BOOT0 low, SPI IRQ on isolated CPU, no runtime PM)
After=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/qstep-rt-tune
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

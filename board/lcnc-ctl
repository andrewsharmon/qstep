# Control the QStep LinuxCNC instance on the UNO Q (run from an adb root shell).
#   lcnc-ctl start            start the AXIS service (auto-restarts when AXIS is closed)
#   lcnc-ctl stop             stop LinuxCNC (service or a manual headless instance)
#   lcnc-ctl restart
#   lcnc-ctl start-headless   stop the service and run the no-GUI config (for scripted tests)
#   lcnc-ctl run <cmd...>     run a command as the arduino user in the config dir
#   lcnc-ctl quit-gui|clean-stale   used by qstep-linuxcnc.service (ExecStop/ExecStartPre)
CFG=/home/arduino/qstep-config
AS_ARDUINO="setpriv --reuid=arduino --regid=arduino --init-groups env HOME=/home/arduino DISPLAY=:1 LINUXCNC_FORCE_REALTIME=1"
SERVICE=qstep-linuxcnc
LOCKFILE=/tmp/linuxcnc.lock
LCNC_PROCS='linuxcnc|linuxcncsvr|milltask|io|rtapi_app|axis'

wait_up() {
	for i in $(seq 1 90); do
		sleep 1
		if pgrep -x milltask >/dev/null && { pgrep -fx "sleep infinity" || pgrep -f "^/usr/bin/python3 /usr/bin/axis -ini"; } >/dev/null; then
			sleep 2
			echo "linuxcnc up"
			return 0
		fi
	done
	echo "linuxcnc did not start; see journalctl -u $SERVICE or /tmp/lcnc.log"
	return 1
}

wait_down() {
	for i in $(seq 1 30); do
		pgrep -x milltask >/dev/null || { echo "linuxcnc stopped"; return 0; }
		sleep 1
	done
	echo "linuxcnc still running"
	return 1
}

stop_manual() {
	# A manual (headless) instance: ending its display makes linuxcnc shut down.
	pid=$(pgrep -fx "sleep infinity")
	[ -n "$pid" ] && kill $pid
}

quit_gui() {
	# AXIS ignores SIGTERM, and the linuxcnc script only runs its SIGTERM trap
	# after AXIS (its foreground child) exits, so a plain stop hangs until
	# systemd's SIGKILL and leaves the lock behind. Ask AXIS to quit instead;
	# linuxcnc then does its normal cleanup and exits. Runs as arduino (ExecStop).
	axis-remote --ping 2>/dev/null && axis-remote --quit
	for i in $(seq 1 10); do
		pgrep -x axis >/dev/null || break
		sleep 1
	done
	# AXIS hung: kill just the GUI so linuxcnc still cleans up.
	pgrep -x axis >/dev/null && pkill -KILL -x axis
	for i in $(seq 1 20); do
		[ -n "$MAINPID" ] && kill -0 "$MAINPID" 2>/dev/null || return 0
		sleep 1
	done
}

clean_stale() {
	# A lock with no LinuxCNC running (e.g. after a SIGKILL) makes linuxcnc
	# ask "still running, restart?" in a Tk dialog on :1 that nobody sees.
	[ -f $LOCKFILE ] || return 0
	if pgrep -x "$LCNC_PROCS" >/dev/null; then
		echo "LinuxCNC is already running (headless instance?); run lcnc-ctl stop first"
		return 1
	fi
	echo "removing stale $LOCKFILE and unloading leftover HAL/RTAPI"
	run=; [ "$(id -u)" = 0 ] && run=$AS_ARDUINO
	$run halrun -U
	rm -f $LOCKFILE
}

case "$1" in
start)
	# The unit's ExecStartPre runs clean-stale on every (re)start.
	systemctl start $SERVICE && wait_up
	;;
stop)
	systemctl stop $SERVICE
	stop_manual
	wait_down
	;;
restart)
	"$0" stop && "$0" start
	;;
start-headless)
	"$0" stop >/dev/null
	clean_stale || exit 1
	cd "$CFG" || exit 1
	$AS_ARDUINO linuxcnc unoq-shield-headless.ini > /tmp/lcnc.log 2>&1 &
	wait_up
	;;
run)
	shift
	cd "$CFG" && exec $AS_ARDUINO "$@"
	;;
quit-gui)
	quit_gui
	;;
clean-stale)
	clean_stale
	;;
*)
	sed -n '4,10p' "$0"
	exit 2
	;;
esac

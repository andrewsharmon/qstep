#!/bin/sh
# First boot of a flashed ArduCNC image (arducnc-firstboot.service):
#  1. copy the LinuxCNC config from /opt/arducnc/config into ~arduino (if absent),
#  2. back up the STM32 flash once (the stock Arduino loader on a fresh board),
#  3. flash the ArduCNC firmware to the STM32.
# Marks /var/lib/arducnc/firstboot-done only when everything succeeded, so a
# failed firmware flash is retried on the next boot.
set -eu
STATE=/var/lib/arducnc
CFG=/home/arduino/arducnc-config
FW=/opt/arducnc/firmware/arducnc-fw.elf
OCD="/opt/openocd/bin/openocd -s /opt/openocd -f openocd_gpiod.cfg"
mkdir -p $STATE

if [ ! -d $CFG ]; then
	cp -r /opt/arducnc/config $CFG
	[ -f /home/arduino/.axisrc ] || cp /opt/arducnc/config/axisrc /home/arduino/.axisrc
	chown -R arduino:arduino $CFG /home/arduino/.axisrc
	echo "arducnc-firstboot: installed LinuxCNC config in $CFG"
fi

# BOOT0 low so resets boot the STM32 from flash (arducnc-rt-tune does this too).
gpioset -c /dev/gpiochip1 -t0 37=0

if [ ! -f $STATE/mcu-flash-backup.bin ]; then
	(cd /opt/openocd && $OCD -c "init; reset halt; dump_image $STATE/mcu-flash-backup.bin.tmp 0x08000000 0x200000; reset run; shutdown")
	mv $STATE/mcu-flash-backup.bin.tmp $STATE/mcu-flash-backup.bin
	echo "arducnc-firstboot: STM32 flash backed up to $STATE/mcu-flash-backup.bin"
fi

if (cd /opt/openocd && $OCD -c "program $FW verify reset exit" 2>&1) | grep -q "Verified OK"; then
	echo "arducnc-firstboot: ArduCNC firmware flashed"
	touch $STATE/firstboot-done
else
	echo "arducnc-firstboot: firmware flash FAILED; will retry next boot" >&2
	exit 1
fi

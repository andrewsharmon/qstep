[Unit]
Description=QStep VNC server for display :1 (localhost only; reach it via adb forward)
Requires=qstep-xvfb.service
After=qstep-xvfb.service

[Service]
User=arduino
# Bound to 127.0.0.1: only reachable through `adb forward tcp:5900 tcp:5900`
# (or an SSH tunnel). A password is required: with no readable
# /etc/qstep/vnc.pass the unit fails (exit 78, not retried) and says why.
# There is no no-password fallback. Set one as root with:  qstep-vnc-passwd
ExecStartPre=/bin/sleep 1
ExecStart=/bin/sh -c 'if [ ! -s /etc/qstep/vnc.pass ] || [ ! -r /etc/qstep/vnc.pass ]; then echo "qstep-vnc: no VNC password set (or /etc/qstep/vnc.pass is unreadable by arduino). Refusing to run without one. Set it as root with: qstep-vnc-passwd" >&2; exit 78; fi; exec /usr/bin/x11vnc -display :1 -localhost -rfbport 5900 -forever -shared -quiet -rfbauth /etc/qstep/vnc.pass'
Restart=on-failure
RestartPreventExitStatus=78
# Keep GUI serving off the real-time core.
CPUAffinity=0-2

[Install]
WantedBy=multi-user.target
